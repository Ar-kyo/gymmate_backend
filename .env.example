
# Configure Resend at https://resend.com and verify your sender domain.
RESEND_API_KEY=re_replace_with_your_resend_api_key
MAIL_FROM_ADDRESS=notifications@your-verified-domain.com
MAIL_FROM_NAME=GymMate
RESEND_RECEIVING_ADDRESS=support@your-receiving-domain.com
RESEND_RECEIVING_WEBHOOK_SECRET=whsec_replace_with_your_receiving_webhook_secret

# Optional legacy PayMongo webhook support for checkout sessions started before manual QR checkout.
# New membership payments use the static QR and admin review flow.
APP_ENV=development
APP_FRONTEND_URL=http://localhost:5173
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYMONGO_WEBHOOK_SECRET=whsk_replace_with_your_webhook_signing_secret
